# 🌐 Production Environment Template

# ⚠️ DO NOT COMMIT THIS FILE with# Copy to `.env` and fill in your actual values

# ========================================
# Database (PostgreSQL for production)
# ========================================
DATABASE_URL="postgresql://user:password@localhost:5432/iitgn_walk_prod"
DB_PROVIDER="postgresql"

# ========================================
# Vercel / Hosting Platform Variables
# ========================================
# Set these in your hosting dashboard (not in code)
VERCEL_TOKEN="your-vercel-token-here"
VERCEL_ORG_ID="your-org-id-here"
VERCEL_PROJECT_ID="your-project-id-here"

# ========================================
# Security (Optional)
# ========================================
# JWT secret for authentication (if added later)
JWT_SECRET="generate-a-random-256-bit-string-here"

# ========================================
# External APIs (Optional)
# ========================================
# Weather API (if using third-party instead of simulation)
# WEATHER_API_KEY="your-api-key"

# Map API (if using Mapbox instead of MapLibre)
# MAPBOX_TOKEN="your-mapbox-token"
