# ============================================================================
# IITGN Walk — Environment Variables (template)
# ============================================================================
# Copy this file to `.env` and adjust values for your environment.
#   cp .env.example .env
#
# NEVER commit your real .env file. The project's .gitignore already
# excludes `.env` and `.env.*` (except this `.env.example`).
# ============================================================================

# ----------------------------------------------------------------------------
# DATABASE_URL — Prisma SQLite connection string.
# Path is RELATIVE TO prisma/schema.prisma. `file:../db/custom.db` therefore
# resolves to <project-root>/db/custom.db on any machine after a fresh clone.
# The db/ folder and the .db file are auto-created by `bun run db:push`.
# ----------------------------------------------------------------------------
DATABASE_URL="file:../db/custom.db"

# ----------------------------------------------------------------------------
# (Optional) NODE_ENV is set automatically by Next.js. No action required.
# ----------------------------------------------------------------------------
