// IITGN Smart Walking Route — Prisma Schema (PostgreSQL)
// This schema supports production deployment with Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Campus points of interest & named locations (hostels, academic blocks, etc.)
model Location {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  category  String
  lng       Float
  lat       Float
  label     String?
  notes     String?
  entryNode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([entryNode])
}

/// Road/path network vertices (intersections, entrances, decision points, gates)
model RoadNode {
  id           String @id @default(cuid())
  slug         String @unique
  lng          Float
  lat          Float
  kind         String
  label        String?
  locationSlug String?

  @@index([locationSlug])
}

/// Walkable edges of the campus network.
model RoadEdge {
  id           String  @id @default(cuid())
  slug         String  @unique
  startNode    String
  endNode      String
  distanceM    Float
  estTimeSec   Float
  roadType     String
  walkable     Boolean @default(true)
  lighting     String?
  surfaceType  String?
  slope        Float?
  trafficLevel String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([startNode, endNode])
  @@index([roadType])
}

/// Configurable walking speed profiles.
model WalkingProfile {
  id        String @id @default(cuid())
  mode      String
  scope     String  @default("CAMPUS")
  userId    String?
  speedMps  Float
  samples   Int     @default(0)
  sumDistM  Float   @default(0)
  sumTimeS  Float   @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([mode, scope, userId])
  @@index([mode])
}

/// A route computation result (snapshot at journey-start time)
model RouteResult {
  id           String   @id @default(cuid())
  objective    String
  fromLocation String?
  toLocation   String?
  mode         String
  distanceM    Float
  durationS    Float
  pathJson     String
  nodeSlugsJson String
  difficulty   Float?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([fromLocation, toLocation])
}

/// An actual journey walked by a student
model Journey {
  id           String    @id @default(cuid())
  userId       String?
  fromLocation String?
  toLocation   String?
  mode         String
  routeId      String?
  predictedS   Float?
  actualS      Float?
  actualM      Float?
  startTs      DateTime
  endTs        DateTime?
  status       String    @default("IN_PROGRESS")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([fromLocation, toLocation])
  @@index([mode])
  @@index([status])
}

/// GPS samples collected during a journey (privacy: no PII beyond coordinates)
model GpsPoint {
  id         String   @id @default(cuid())
  journeyId  String
  lat        Float
  lng        Float
  accuracyM  Float?
  capturedTs DateTime
  matched    Boolean  @default(false)
  matchedNode String?

  @@index([journeyId])
  @@index([capturedTs])
}

/// Campus visual features (buildings, greens, courts, sports fields, water).
model CampusFeature {
  id        String   @id @default(cuid())
  kind      String
  name      String?
  geomJson  String
  color     String?
  createdAt DateTime @default(now())

  @@index([kind])
}

/// A shared route record (for community route sharing / public links).
model SharedRoute {
  id          String   @id @default(cuid())
  /// e.g. r_abc123_def456
  routeResult Json
  fromLocation String?
  toLocation   String?
  mode         String
  /// ISO timestamp when this share expires (null = never)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([expiresAt])
}
