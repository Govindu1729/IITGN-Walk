{
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "installCommand": "bun install",
  "outputDirectory": ".next/standalone",
  "regions": ["sin1"],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/:path*" }],
  "env": {
    "DATABASE_URL": "DATABASE_URL"
  }
}
